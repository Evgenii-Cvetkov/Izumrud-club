# ─── Основное ────────────────────────────────────────────────
# Публичный адрес сайта, без слеша в конце. Нужен для ссылок в письмах и возврата после оплаты.
APP_URL=http://localhost:3000
# Длинная случайная строка: подпись ссылок на файлы и хэши кодов входа.
# Сгенерировать: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string

DATABASE_URL=postgres://postgres:postgres@localhost:5432/izumrud

# ─── Подписка ────────────────────────────────────────────────
# Цена в рублях и длительность периода. Менять только вместе с офертой.
PRICE_RUB=10000
# Сколько дней доступа остаётся после неудачного автосписания
GRACE_DAYS=3

# ─── ЮKassa ──────────────────────────────────────────────────
# Пока SHOP_ID пуст, оплата работает в демо-режиме: вместо ЮKassa открывается
# тестовая страница /dev/mock-pay, деньги не списываются.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 — передавать данные для чеков (Чеки от ЮKassa или облачная касса).
YOOKASSA_RECEIPTS=1
# Код ставки НДС для чека: 1 — без НДС. Уточнить у бухгалтера.
YOOKASSA_VAT_CODE=1

# ─── Почта ───────────────────────────────────────────────────
# Пока SMTP_HOST пуст, письма не отправляются, а печатаются в лог сервера.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Клуб «Изумруд» <club@example.ru>"

# ─── Видео ───────────────────────────────────────────────────
# demo — тестовый HLS-поток для разработки; kinescope — плеер Kinescope.
VIDEO_PROVIDER=demo
DEMO_HLS_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8

# ─── Файлы (аудио, фото, обложки) ────────────────────────────
# local — файлы в папке storage/ рядом с приложением, выдача по подписанным ссылкам.
# s3 — Yandex Object Storage или другое S3-совместимое хранилище.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Push-уведомления ────────────────────────────────────────
# Сгенерировать: npm run push:keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:club@example.ru

# ─── Directus (админка) ──────────────────────────────────────
DIRECTUS_KEY=change-me
DIRECTUS_SECRET=change-me
DIRECTUS_ADMIN_EMAIL=admin@example.ru
DIRECTUS_ADMIN_PASSWORD=change-me
