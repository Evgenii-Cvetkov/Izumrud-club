{
  "name": "izumrud-club",
  "version": "0.1.0",
  "private": true,
  "description": "Сайт клуба развития мышления «Изумруд»: членство по подписке, лекции, статьи, фото встреч",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "worker:once": "tsx worker/index.ts --once",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "audio:extract": "tsx scripts/extract-audio.ts",
    "push:keys": "web-push generate-vapid-keys",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "directus:setup": "tsx scripts/directus-setup.ts",
    "check:billing": "tsx scripts/check-billing.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/golos-text": "^5.3.0",
    "drizzle-orm": "^0.45.4",
    "hls.js": "^1.7.3",
    "next": "15.5",
    "nodemailer": "^10.1.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
